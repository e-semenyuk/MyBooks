// This is your Prisma schema file for Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum PromoType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  name          String
  role          UserRole  @default(USER)
  emailVerifiedAt   DateTime?
  locale            String    @default("en")
  failedLogins      Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?
  deactivatedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  cartItems     CartItem[]
  addresses     Address[]
  authTokens    AuthToken[]
  payments      Payment[]
  pushSubscriptions PushSubscription[]
  pushMessages  PushMessage[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  auditEntries  AuditLog[]

  @@index([email])
  @@map("users")
}

model Book {
  id            Int         @id @default(autoincrement())
  title         String
  author        String
  isbn          String?     @unique
  priceCents    Int
  description   String?     @db.Text
  stockQuantity Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  cartItems     CartItem[]
  categories    BookCategory[]
  cover         BookCover?
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([title])
  @@index([author])
  @@index([priceCents])
  @@index([createdAt])
}

// A cart item belongs to a signed-in user or to a guest session, never both.
// The check constraint lives in the migration (Prisma cannot express it).
model CartItem {
  id        Int      @id @default(autoincrement())
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  quantity  Int
  sessionId String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, bookId])
  @@unique([userId, bookId])
  @@index([sessionId])
  @@index([userId])
  @@index([bookId])
  @@map("cart_items")
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String
  customerAddress String      @db.Text
  orderDate       DateTime    @default(now())
  subtotalCents   Int            @default(0)
  discountCents   Int            @default(0)
  shippingCents   Int            @default(0)
  taxCents        Int            @default(0)
  totalCents      Int
  shippingMethod  ShippingMethod @default(STANDARD)
  promoCode       String?
  status          OrderStatus @default(CONFIRMED)
  orderItems      OrderItem[]
  events          OrderEvent[]
  payments        Payment[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([customerEmail])
  @@index([status])
  @@index([orderDate])
  @@map("orders")
}

model OrderItem {
  id       Int   @id @default(autoincrement())
  orderId  Int
  bookId   Int
  quantity   Int
  priceCents Int
  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book     Book  @relation(fields: [bookId], references: [id])

  @@index([orderId])
  @@index([bookId])
  @@map("order_items")
}


// One row per status change. The first row of an order has no fromStatus.
model OrderEvent {
  id         Int          @id @default(autoincrement())
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    Int?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
  @@map("order_events")
}

model Category {
  id    Int            @id @default(autoincrement())
  name  String         @unique
  slug  String         @unique
  books BookCategory[]

  @@map("categories")
}

model BookCategory {
  bookId     Int
  categoryId Int
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([bookId, categoryId])
  @@index([categoryId])
  @@map("book_categories")
}

// PERCENT: value is a whole percent (1 to 100). FIXED: value is cents.
model PromoCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      PromoType
  value     Int
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@map("promo_codes")
}

model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("")
  fullName   String
  street     String
  city       String
  postalCode String
  country    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

// One-time links for password reset and email verification. Only the hash of
// the token is stored; the token itself exists in the email only.
model AuthToken {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
  @@map("auth_tokens")
}

// Every email the app sends is recorded here first, then handed to SMTP when
// SMTP_HOST is set. Tests read it through /api/test/emails.
model EmailOutbox {
  id        Int       @id @default(autoincrement())
  to        String
  subject   String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  error     String?

  @@index([to])
  @@map("email_outbox")
}

// Uploaded cover image, kept apart from Book so listing books never loads the bytes.
model BookCover {
  bookId      Int      @id
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  size        Int
  updatedAt   DateTime @updatedAt

  @@map("book_covers")
}

// One row per attempt to take money. A failed attempt has no order; a paid one
// is linked to the order created from it. Card numbers and CVCs are never stored.
model Payment {
  id             Int           @id @default(autoincrement())
  userId         Int
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        Int?
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amountCents    Int
  status         PaymentStatus
  provider       String        @default("mock")
  providerRef    String?
  cardBrand      String?
  cardLast4      String?
  failureCode    String?
  failureMessage String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([orderId])
  @@index([userId])
  @@map("payments")
}

// A browser that agreed to receive push notifications.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// Every push the app decided to send, so tests and support can see them.
model PushMessage {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  orderId   Int?
  title     String
  body      String
  url       String
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  error     String?

  @@index([userId])
  @@map("push_messages")
}

// One review per buyer and book. HIDDEN reviews are kept for admins only.
model Review {
  id        Int          @id @default(autoincrement())
  bookId    Int
  book      Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String?      @db.Text
  status    ReviewStatus @default(VISIBLE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([bookId, userId])
  @@index([bookId, status])
  @@index([userId])
  @@map("reviews")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId])
  @@map("wishlist_items")
}

// Who changed what: prices, stock, order status, roles, accounts, moderation, imports.
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  Int?
  summary   String
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entity, entityId])
  @@map("audit_log")
}
