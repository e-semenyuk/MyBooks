// This is your Prisma schema file for Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum PromoType {
  PERCENT
  FIXED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  name          String
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  cartItems     CartItem[]

  @@index([email])
  @@map("users")
}

model Book {
  id            Int         @id @default(autoincrement())
  title         String
  author        String
  isbn          String?     @unique
  priceCents    Int
  description   String?     @db.Text
  stockQuantity Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  cartItems     CartItem[]
  categories    BookCategory[]

  @@index([title])
  @@index([author])
  @@index([priceCents])
  @@index([createdAt])
}

// A cart item belongs to a signed-in user or to a guest session, never both.
// The check constraint lives in the migration (Prisma cannot express it).
model CartItem {
  id        Int      @id @default(autoincrement())
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  quantity  Int
  sessionId String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, bookId])
  @@unique([userId, bookId])
  @@index([sessionId])
  @@index([userId])
  @@index([bookId])
  @@map("cart_items")
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String
  customerAddress String      @db.Text
  orderDate       DateTime    @default(now())
  subtotalCents   Int            @default(0)
  discountCents   Int            @default(0)
  shippingCents   Int            @default(0)
  taxCents        Int            @default(0)
  totalCents      Int
  shippingMethod  ShippingMethod @default(STANDARD)
  promoCode       String?
  status          OrderStatus @default(CONFIRMED)
  orderItems      OrderItem[]
  events          OrderEvent[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([customerEmail])
  @@index([status])
  @@index([orderDate])
  @@map("orders")
}

model OrderItem {
  id       Int   @id @default(autoincrement())
  orderId  Int
  bookId   Int
  quantity   Int
  priceCents Int
  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book     Book  @relation(fields: [bookId], references: [id])

  @@index([orderId])
  @@index([bookId])
  @@map("order_items")
}


// One row per status change. The first row of an order has no fromStatus.
model OrderEvent {
  id         Int          @id @default(autoincrement())
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    Int?
  createdAt  DateTime     @default(now())

  @@index([orderId])
  @@map("order_events")
}

model Category {
  id    Int            @id @default(autoincrement())
  name  String         @unique
  slug  String         @unique
  books BookCategory[]

  @@map("categories")
}

model BookCategory {
  bookId     Int
  categoryId Int
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([bookId, categoryId])
  @@index([categoryId])
  @@map("book_categories")
}

// PERCENT: value is a whole percent (1 to 100). FIXED: value is cents.
model PromoCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      PromoType
  value     Int
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@map("promo_codes")
}
