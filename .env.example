# Copy to .env.local for local development (docker compose up -d).
# Never point local runs at the deployed Supabase database.
POSTGRES_PRISMA_URL=postgresql://bookstore:bookstore@localhost:5433/bookstore?schema=public

NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Used by `npm run db:seed` to create the admin account.
ADMIN_EMAIL=admin@bookstore.local
ADMIN_PASSWORD=

# Dev mail catcher (Mailpit UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
