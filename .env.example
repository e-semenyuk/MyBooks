# Copy to .env.local for local development (docker compose up -d).
# Never point local runs at the deployed Supabase database.
POSTGRES_PRISMA_URL=postgresql://bookstore:bookstore@localhost:5433/bookstore?schema=public

NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Dev mail catcher (Mailpit UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# Needed for a real mail server; leave empty for Mailpit
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bookstore <no-reply@bookstore.local>

# Seed accounts (npm run db:seed). The seed wipes ALL data, so use it on local/test databases only.
# No default passwords exist in the repository.
ADMIN_EMAIL=admin@bookstore.local
ADMIN_PASSWORD=
# Optional regular user for tests (set both or neither)
USER_EMAIL=
USER_PASSWORD=

# Test support endpoints (/api/test/reset, /api/test/seed). Leave unset in production.
ENABLE_TEST_ENDPOINTS=false
# At least 16 characters; sent by callers as the x-test-secret header
TEST_SECRET=

# Email verification is enforced when SMTP_HOST is set; force it with true or false.
# Local runs and tests read the link from the outbox, so set true to exercise it.
REQUIRE_EMAIL_VERIFICATION=

# Set to true in test environments so repeated sign-ins and registrations are not throttled
RATE_LIMIT_DISABLED=false

# Tax rate on the discounted subtotal (0.08 = 8%)
TAX_RATE=0.08
